PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=your-db-password
DB_NAME=flowmon

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=24h

# Sync interval for WebSocket push (ms)
WS_PUSH_INTERVAL_MS=15000

# Geo-IP database path (optional — download from https://dev.maxmind.com/)
GEOIP_DB_PATH=

# Structured log level: error | warn | info | debug (default: info)
LOG_LEVEL=info

# Sentry error monitoring (optional — leave blank to disable)
SENTRY_DSN=

# PostHog product analytics (optional — leave blank to fall back to log events)
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
